---
import Base from '../layouts/Base.astro';
import bookHero from '../assets/book-hero.png';
import guardianLogo from '../assets/press/the-guardian.svg';
import theLogo from '../assets/press/times-higher-education.svg';
import chronicleLogo from '../assets/press/the-chronicle.png';
---

<Base
  title="Academia Obscura"
  description="The lighter side of academia. Silly, not stupid."
  path="/"
>
  <section class="hero hero-home">
    <h1 class="hero-home-title">Academia Obscura</h1>
    <div class="hero-book">
      <img
        src={bookHero.src}
        width={bookHero.width}
        height={bookHero.height}
        alt="Academia Obscura: The Hidden Silly Side of Higher Education"
        fetchpriority="high"
      />
    </div>
    <div class="hero-blurb lede">
      <p>
        If you think the groves of academe are all stuffiness, elbow patches and greying old men...
        think again.
      </p>
      <p>
        Academia Obscura is an irreverent glimpse inside the ivory tower, exposing the eccentric
        and slightly unhinged world of university life. Take a trip through the spectrum of academic
        oddities and unearth the Easter eggs buried in peer reviewed papers, the weird and wonderful
        world of scholarly social media, and rats in underpants.
      </p>
    </div>
  </section>

  <div class="wrap">
    <h2 class="press-heading">As seen in</h2>
    <ul class="press">
      <li>
        <a href="https://www.theguardian.com/global/series/grooves-of-academe">
          <img
            src={guardianLogo.src}
            width="140"
            height="46"
            alt="The Guardian"
            loading="lazy"
          />
        </a>
      </li>
      <li>
        <a href="https://www.timeshighereducation.com/author/glen-wright">
          <img
            src={theLogo.src}
            width="120"
            height="48"
            alt="Times Higher Education"
            loading="lazy"
          />
        </a>
      </li>
      <li>
        <a
          href="https://www.chronicle.com/blogs/wiredcampus/meet-the-26-year-old-behind-academic-twitters-most-popular-hashtags"
        >
          <img
            src={chronicleLogo.src}
            width={chronicleLogo.width}
            height={chronicleLogo.height}
            alt="The Chronicle of Higher Education"
            loading="lazy"
          />
        </a>
      </li>
    </ul>
  </div>
</Base>
