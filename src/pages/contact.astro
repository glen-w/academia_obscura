---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contact"
  description="Get in touch — personal site, email, or book a meeting with Glen Wright."
  path="/contact/"
>
  <div class="wrap">
    <h1>Contact</h1>
    <div class="contact-actions">
      <p>
        <a href="https://glenwright.earth/">Personal website</a>
      </p>
      <p>
        <a
          href="https://meet.glenwright.earth/u/book/half-hour"
          rel="external noopener"
          target="_blank"
        >
          Book a meeting
        </a>
      </p>
      <p>
        <a href="mailto:glen.w.wright@gmail.com">Email</a>
      </p>
    </div>
  </div>
</Base>
