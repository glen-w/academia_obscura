---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { bestThumbnailFromMarkdown } from '../../lib/blogThumbnail';

const published = (await getCollection('blog'))
  .filter((p) => p.data.draft !== true)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const posts = await Promise.all(
  published.map(async (post) => ({
    post,
    thumbnail: await bestThumbnailFromMarkdown(post.body),
  })),
);

function hrefFor(post: (typeof posts)[number]['post']) {
  return `/blog/${post.id}/`;
}

function formatDate(d: Date) {
  return d.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<Base
  title="Blog"
  description="The Academia Obscura writing archive — odd papers, obscure rituals, and academic curiosities."
  path="/blog/"
>
  <div class="wrap">
    <header class="blog-header">
      <h1>Blog</h1>
    </header>

    {
      posts.length === 0 ? (
        <p class="quiet">Nothing posted yet.</p>
      ) : (
        <ol class="post-list">
          {posts.map(({ post, thumbnail }) => (
            <li>
              <a class="post-list-item" href={hrefFor(post)}>
                {thumbnail ? (
                  <img
                    class="post-list-thumb"
                    src={thumbnail}
                    alt=""
                    width="72"
                    height="72"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="post-list-thumb post-list-thumb--placeholder" aria-hidden="true" />
                )}
                <span class="post-list-copy">
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                  <span class="post-list-title">{post.data.title}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</Base>
