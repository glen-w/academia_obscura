---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog'))
  .filter((p) => p.data.draft !== true)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function hrefFor(post: (typeof posts)[number]) {
  return `/blog/${post.id}/`;
}

function formatDate(d: Date) {
  return d.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<Base
  title="Blog"
  description="The Academia Obscura writing archive — odd papers, obscure rituals, and academic curiosities."
  path="/blog/"
>
  <div class="wrap">
    <header class="blog-header">
      <h1>Blog</h1>
      <p class="tagline">Silly, not stupid.</p>
      <p class="lede blog-lede">
        The writing archive from 2014 onwards. Odd papers, obscure rituals, and the lighter side of
        higher education.
      </p>
    </header>

    {
      posts.length === 0 ? (
        <p class="quiet">Nothing posted yet.</p>
      ) : (
        <ol class="post-list">
          {posts.map((post) => (
            <li>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <a href={hrefFor(post)}>{post.data.title}</a>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</Base>
