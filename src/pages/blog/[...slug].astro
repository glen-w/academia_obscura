---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => p.data.draft !== true);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(d: Date) {
  return d.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

const description =
  post.data.description ||
  `Academia Obscura — ${post.data.title}`;
---

<Base title={post.data.title} description={description} path={`/blog/${post.id}/`}>
  <article class="wrap post">
    <header class="post-header">
      <p class="post-meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      </p>
      <h1>{post.data.title}</h1>
    </header>
    <div class="post-body">
      <Content />
    </div>
    <p class="post-back"><a href="/blog/">← All posts</a></p>
  </article>
</Base>
