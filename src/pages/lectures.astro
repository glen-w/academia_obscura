---
import Base from '../layouts/Base.astro';

const lecturePhoto = '/lectures/academia-obscura-pub-lecture.jpg';
const lectureSlides = '/lectures/academia-obscura-lecture-slides.pdf';
---

<Base
  title="Lectures"
  description="Academia Obscura lectures — a cabinet of academic curiosities, not your average seminar."
  path="/lectures/"
>
  <div class="wrap wide">
    <h1>Lectures</h1>
    <p>
      An Academia Obscura lecture is not your average lecture. Think a cabinet of academic
      curiosities: the lighter, and darker, side of scholarly life, with slides.
    </p>

    <div class="lecture-showcase">
      <figure class="lecture-photo">
        <img
          src={lecturePhoto}
          width={960}
          height={640}
          alt="Glen Wright presenting Academia Obscura in a pub, with slides on screen"
          loading="lazy"
        />
      </figure>

      <div class="lecture-pdf">
        <iframe
          src={`${lectureSlides}#view=FitH`}
          title="Academia Obscura lecture slides (PDF)"
        ></iframe>
        <p class="quiet pdf-fallback">
          <a href={lectureSlides} target="_blank" rel="noopener noreferrer">
            Open or download the slides (PDF)
          </a>
          — use your browser’s PDF controls to move between pages.
        </p>
      </div>
    </div>

    <p>
      Enquiries:
      <a href="/contact/">Contact</a>.
    </p>
  </div>
</Base>
